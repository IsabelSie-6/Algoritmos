programa {
  funcao inicio() {
    //Definições das variáveis (valores e nomes)
    cadeia nomeProduto
    inteiro quantidadeProduto
    real precoProduto
    logico freteProduto 
 
    // Declarações das variáveis (nome, valores, quantidades)
    nomeProduto = "Box Era uma vez um coração partido"
    quantidadeProduto = 3
    precoProduto = 136.60
    freteProduto = verdadeiro
   
   // Carrinho de compras definitivo 
    escreva(" Carrinho de compras ")
    escreva( nomeProduto, "\n")
    escreva("Preço: ", precoProduto, "\n")
    escreva(" Frete ", freteProduto, "\n")
    escreva("Chegará grátis segunda-feira, 27 de julho.")
  }
}

programa {
  funcao inicio() {
real celsius, fahrenheit 

    /*Conversor de Temperatura 
    Crie um programa para um painel meteorológico que leia uma temperatura em graus Celsius e a converta para Fahrenheit. A fórmula de conversão é: F = (C * 1.8) + 32.  */

    escreva("Digite a temperatura em Celsius: ")
    leia(celsius)

    fahrenheit = (celsius * 1.8 + 32) 

    escreva("A temperatura em Fahrenheit é de: ", fahrenheit)
  }
}

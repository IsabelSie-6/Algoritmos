programa {
  funcao inicio() {
   
    inteiro dinheiroTurista
    real dolar, reaisBR, cotacao
  
/*O Conversor de Câmbio Um turista precisa converter seus Reais (R$) para Dólares (US$). 
  Crie um programa que leia o valor que o turista tem na carteira e a cotação atual do dólar. 
  O sistema deve calcular e exibir quantos dólares ele conseguirá comprar. 
*/
    escreva("Escreva sua quantia de dinheiro: ")

    leia(reaisBR)

    escreva("Escreva a cotação do dolar: ")
    leia(cotacao )
  
    dolar = reaisBR / cotacao 

    escreva("Seu saldo é de: ", dolar, "dólares.")

    



    



    
     
  }
}
